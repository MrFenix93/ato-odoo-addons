<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_account_ar_user" model="res.groups">
        <field name="name">AR Accountant</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_account_ap_user" model="res.groups">
        <field name="name">AP Accountant</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <!-- AR user: receivable accounts -->
    <record id="rule_account_ar_user_accounts" model="ir.rule">
        <field name="name">AR User: Receivable Accounts Only</field>
        <field name="model_id" ref="account.model_account_account"/>
        <field name="global" eval="False"/>
        <field name="groups" eval="[(4, ref('account_ar_ap_roles.group_account_ar_user'))]"/>
        <field name="domain_force">
            [
                '|',
                    ('account_type', '=', 'asset_receivable'),
                    ('account_type', 'not in', ['asset_receivable', 'liability_payable'])
            ]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- AP user: payable accounts -->
    <record id="rule_account_ap_user_accounts" model="ir.rule">
        <field name="name">AP User: Payable Accounts Only</field>
        <field name="model_id" ref="account.model_account_account"/>
        <field name="global" eval="False"/>
        <field name="groups" eval="[(4, ref('account_ar_ap_roles.group_account_ap_user'))]"/>
        <field name="domain_force">
            [
                '|',
                    ('account_type', '=', 'liability_payable'),
                    ('account_type', 'not in', ['asset_receivable', 'liability_payable'])
            ]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- AR user:  journal entries ???? receivable -->
    <record id="rule_account_ar_user_moves" model="ir.rule">
        <field name="name">AR User: Receivable Journal Entries Only</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="global" eval="False"/>
        <field name="groups" eval="[(4, ref('account_ar_ap_roles.group_account_ar_user'))]"/>
        <field name="domain_force">
            [('line_ids.account_id.account_type', '=', 'asset_receivable')]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- AP user: journal entries ???? payable -->
    <record id="rule_account_ap_user_moves" model="ir.rule">
        <field name="name">AP User: Payable Journal Entries Only</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="global" eval="False"/>
        <field name="groups" eval="[(4, ref('account_ar_ap_roles.group_account_ap_user'))]"/>
        <field name="domain_force">
            [('line_ids.account_id.account_type', '=', 'liability_payable')]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>